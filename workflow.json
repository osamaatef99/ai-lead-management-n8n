    "jsCode": "\nconst lead = $('Normalize & Validate').item.json;\n\nconst rawError =\n  $json.error?.message ??\n  $json.message ??\n  $json.description ??\n  'AI generation failed';\n\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    submitted_at: lead.submitted_at,\n    full_name: lead.full_name,\n    email: lead.email,\n    service: lead.service,\n    budget: lead.budget,\n    ai_message: '',\n    lead_status: 'AI Error',\n    validation_errors: '',\n    source: 'n8n Form',\n    error_details: String(rawError).slice(0, 500)\n  }\n};\n"
