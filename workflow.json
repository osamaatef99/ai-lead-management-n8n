  {
   "parameters": {
    "method": "POST",
    "url": "https://api.groq.com/openai/v1/chat/completions",
    "authentication": "predefinedCredentialType",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "=\n{{ JSON.stringify({\n  model: \"openai/gpt-oss-20b\",\n  messages: [\n    {\n      role: \"user\",\n      content:\n        \"Write a warm, concise, professional first-response draft in English.\\n\" +\n        \"Customer name: \" + $json.full_name + \"\\n\" +\n        \"Requested service: \" + $json.service + \"\\n\" +\n        \"Estimated budget: \" + $json.budget + \" USD\\n\" +\n        \"Acknowledge the request, do not invent prices or delivery dates, \" +\n        \"ask exactly one relevant follow-up question, and keep the message under 70 words. \" +\n        \"Return only the final message. Do not claim it was sent.\"\n    }\n  ],\n  max_completion_tokens: 512,\n  reasoning_effort: \"low\",\n  include_reasoning: false,\n  temperature: 0.4,\n  stream: false\n}) }}\n\n",
    "options": {
     "response": {
      "response": {
       "responseFormat": "json"
      }
     }
    },
    "nodeCredentialType": "groqApi"
   },
