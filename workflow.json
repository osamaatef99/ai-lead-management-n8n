  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "\nconst lead = $('Normalize & Validate').item.json;\n\nconst raw = $json.choices?.[0]?.message?.content;\nlet ai_message = String(raw ?? '').trim();\n\n// Remove placeholder signature\nai_message = ai_message\n  .replace(/\\s*(?:Best regards|Kind regards|Regards),?\\s*\\n*\\[Your Name\\]\\s*$/i, '')\n  .replace(/\\[Your Name\\]/gi, '')\n  .trim();\n\nif (!ai_message) {\n  throw new Error('AI response is empty. Cannot save this lead.');\n}\n\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    submitted_at: lead.submitted_at,\n    full_name: lead.full_name,\n    email: lead.email,\n    service: lead.service,\n    budget: lead.budget,\n    ai_message,\n    lead_status: 'New',\n    validation_errors: '',\n    source: 'n8n Form'\n  }\n};\n\n"
   },
