    "formTitle": "New Project Inquiry",
    "formDescription": "Tell us about the automation service you need",
    "formFields": {
     "values": [
      {
       "fieldLabel": "Your name"
      },
      {
       "fieldLabel": "Email address"
      },
      {
       "fieldLabel": "Service needed"
      },
      {
       "fieldLabel": "Estimated budget (USD)"
      }
     ]
    },
    "options": {}
   },
   "id": "0776efd4-0705-4ec6-99cf-6d91e712f071",
   "name": "On form submission",
   "type": "n8n-nodes-base.formTrigger",
   "typeVersion": 2.6,
   "position": [
    -624,
    240
   ]
  },
  {
   "parameters": {
    "jsCode": "\nconst j = $json;\n\n// Read the actual form fields\nconst full_name = String(j[\"Your name\"] ?? \"\").trim();\nconst email = String(j[\"Email address\"] ?? \"\").trim().toLowerCase();\nconst service = String(j[\"Service needed\"] ?? \"\").trim();\n\nconst budgetRaw = j[\"Estimated budget (USD)\"];\nconst budgetText =\n  budgetRaw === undefined || budgetRaw === null\n    ? \"\"\n    : String(budgetRaw).trim();\n\nconst budget = budgetText === \"\" ? NaN : Number(budgetText);\n\n// Collect validation errors\nconst errors = [];\n\nif (full_name.length < 2) {\n  errors.push(\"full_name_missing_or_too_short\");\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  errors.push(\"email_invalid\");\n}\n\nif (!service) {\n  errors.push(\"service_missing\");\n}\n\nif (\n  budgetText === \"\" ||\n  !Number.isFinite(budget) ||\n  budget < 0\n) {\n  errors.push(\"budget_missing_or_invalid\");\n}\n\n// Return normalized data\nreturn {\n  json: {\n    lead_id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\n    submitted_at: j.submittedAt || new Date().toISOString(),\n    full_name,\n    email,\n    service,\n    budget: Number.isFinite(budget) ? budget : \"\",\n    is_valid: errors.length === 0,\n    validation_errors: errors.join(\", \"),\n    lead_status: errors.length === 0 ? \"New\" : \"Needs Review\",\n    ai_message: \"\",\n    source: \"n8n Form\"\n  }\n};\n"
   },
